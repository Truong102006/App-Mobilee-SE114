# Spring profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Firebase credentials (prefer repo-relative path to avoid Windows path encoding issues)
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# App Check verification settings
BACKEND_SECURITY_REQUIRE_APP_CHECK=true
BACKEND_SECURITY_FIREBASE_PROJECT_NUMBER=1234567890

# Gemini
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_UPLOAD_FOLDER=soulmate_uploads

# SePay premium payments
SEPAY_API_TOKEN=replace_me
SEPAY_WEBHOOK_SECRET=replace_me
SEPAY_BANK_CODE=Vietcombank
SEPAY_BANK_ACCOUNT=replace_me
SEPAY_ACCOUNT_HOLDER=SOULMATE
SEPAY_API_URL=https://my.sepay.vn/userapi
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_WEBHOOK_MAX_SKEW_SECONDS=300
SEPAY_RECONCILE_COOLDOWN_SECONDS=15

PREMIUM_PLAN_CODE=PREMIUM_30D_V1
PREMIUM_PRICE_VND=49000
PREMIUM_DURATION_DAYS=30
PAYMENT_ORDER_EXPIRE_MINUTES=15
PAYMENT_RECONCILE_WINDOW_HOURS=24
