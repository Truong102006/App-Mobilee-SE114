rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByField(fieldName) {
      return isSignedIn() && resource.data[fieldName] == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /pets/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /diaries/{diaryId} {
      // Diary data must go through backend (Firebase Admin SDK), not direct client access.
      allow read, write: if false;
    }

    match /chats/{chatId} {
      // Chat data must go through backend (Firebase Admin SDK), not direct client access.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
